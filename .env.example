# ============================================================
# InnoCite 环境变量配置模板
# 复制此文件为 .env 并填写实际值
# ============================================================

# ── 应用环境 ──
# APP_ENV=development

# ── LLM 大语言模型配置 ──
# DeepSeek API（主力）→ 规则引擎（兜底）
# 获取 API Key：https://platform.deepseek.com/
# 定价极低：约 ¥1/百万 tokens
# DEEPSEEK_API_KEY=sk-xxxxx
# DEEPSEEK_MODEL=deepseek-v4-flash        # 快速任务（推荐理由、分类）
# DEEPSEEK_MODEL_PRO=deepseek-v4-pro      # 深度推理（创新点提取）

# ── 功能开关 ──
# LLM_INNOVATION_ENABLED=1   # 创新点LLM提取
# LLM_REASON_ENABLED=1       # 推荐理由LLM生成
# KEYBERT_ENABLED=1          # KeyBERT关键词提取
# AUTO_CLASSIFY_ENABLED=1    # 论文自动分类

# ── LLM 参数 ──
# LLM_TIMEOUT=30
# LLM_TEMPERATURE=0.3
